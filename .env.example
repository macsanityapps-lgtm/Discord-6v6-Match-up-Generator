# Copy this file to .env and fill in your values
DISCORD_TOKEN=your_bot_token_here

# Your Discord server ID — makes slash commands appear instantly (recommended during setup)
# Right-click your server icon → Copy Server ID (requires Developer Mode)
GUILD_ID=your_server_id_here

# Optional: Restrict bot commands to specific channel IDs (comma-separated)
# ALLOWED_CHANNELS=123456789,987654321

# Optional: Admin/Mod role ID that can use mod commands
# MOD_ROLE_ID=123456789
